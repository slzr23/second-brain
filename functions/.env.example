# Copy to functions/.env.<your-project-id> (git-ignored).
# Your Firebase Auth uid: sign in once on the web app, then copy it from
# Firebase console > Authentication > Users.
OWNER_UID=

# INGEST_TOKEN is a secret, not an env var. Set it with:
#   openssl rand -base64 32 | firebase functions:secrets:set INGEST_TOKEN --data-file=-

# Bank sync (Enable Banking, see docs/banque.md)
ENABLE_BANKING_APP_ID=
# Exact name from GET /aspsps, e.g. "Caisse d'Epargne Ile-de-France"
BANK_ASPSP=
# ENABLE_BANKING_KEY is a secret: the .pem downloaded when registering the app.
#   firebase functions:secrets:set ENABLE_BANKING_KEY --data-file=<app-id>.pem
APP_URL=https://<ton-projet>.web.app

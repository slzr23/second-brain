# Copy to functions/.env.<your-project-id> (git-ignored).
# Your Firebase Auth uid: sign in once on the web app, then copy it from
# Firebase console > Authentication > Users.
OWNER_UID=

# INGEST_TOKEN is a secret, not an env var. Set it with:
#   openssl rand -base64 32 | firebase functions:secrets:set INGEST_TOKEN --data-file=-

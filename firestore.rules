rules_version = '2';

// Single-user app: everything lives under users/{uid} and only that user can read it.
// The app itself may only write what it needs; imports (Strava, bank, prices,
// Claude reports) are written by Cloud Functions with the Admin SDK, which bypasses rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Read access to every sub-collection.
      match /{collection}/{docId} {
        allow read: if isOwner(uid);
      }

      // Thoughts typed from the web app.
      match /entries/{docId} {
        allow create: if isOwner(uid)
          && request.resource.data.kind in ['dream', 'note']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 20000;
        allow update, delete: if isOwner(uid);
      }

      // Expenses typed in the app, and sorting one (essentiel / social / superflu).
      match /transactions/{docId} {
        allow create: if isOwner(uid)
          && request.resource.data.source == 'manual'
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents != 0
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 200
          && request.resource.data.necessity in ['essentiel', 'social', 'superflu', null];
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['necessity'])
          && request.resource.data.necessity in ['essentiel', 'social', 'superflu', null];
      }

      // Savings and investments, typed in the app; prices of tracked ones are
      // then refreshed every evening by the refreshPrices function.
      function validHolding(d) {
        return d.group is string && d.group.size() > 0 && d.group.size() <= 60
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.units is number && d.units >= 0
          && d.unitPrice is number && d.unitPrice >= 0
          && (d.tracker == null
            || (d.tracker.symbol is string && d.tracker.symbol.size() > 0 && d.tracker.symbol.size() <= 20
              && d.tracker.baseUnitPrice is number));
      }
      match /holdings/{docId} {
        allow create, update: if isOwner(uid) && validHolding(request.resource.data);
        allow delete: if isOwner(uid);
      }

      // Accepting or rejecting a training adjustment proposed by Claude.
      match /proposals/{docId} {
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'rejected'];
      }
    }
  }
}

# Copy to .env.local and fill with your Firebase web app config
# (Firebase console > Project settings > Your apps). These values are public by design:
# access is protected by Firestore security rules, not by hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Leave empty for real data. "true" shows fake data without signing in.
VITE_DEMO=
